{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "migrate:validation-phase2": "node ./scripts/run-validation-phase2-migration.mjs",
    "migrate:validation-experiments": "node ./scripts/run-validation-experiments-migration.mjs",
    "migrate:validation-results": "node ./scripts/run-validation-results-migration.mjs",
    "migrate:roadmap": "node ./scripts/run-roadmap-migration.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
